@page "/"
@inject IWebHostEnvironment Env

<PageTitle>ScriptEditor - ConversaCore Workflow Studio</PageTitle>

<div class="editor-shell">
    @{
        var distIndex = Path.Combine(Env.ContentRootPath, "canvas-app", "dist", "index.html");
        var version = File.Exists(distIndex) ? File.GetLastWriteTimeUtc(distIndex).Ticks.ToString() : DateTime.UtcNow.Ticks.ToString();
    }
    @if (File.Exists(distIndex))
    {
        <div class="window-wrapper">
            <iframe src="/canvas/index.html?v=@version" class="canvas-frame" title="ConversaCore ScriptEditor Canvas"></iframe>
        </div>
    }
    else
    {
        <div class="dev-banner">
            <h2>ConversaCore ScriptEditor</h2>
            <p>The modern React Flow canvas application is running in development mode or needs building.</p>
            <p>Run <code>npm run build</code> in <code>canvas-app/</code> to bundle the standalone app for production hosting.</p>
            <a href="http://localhost:5173" target="_blank" class="btn btn-primary">Open Canvas in Vite Dev Server</a>
        </div>
    }
</div>

<style>
    .editor-shell {
        width: 100vw;
        height: 100vh;
        margin: 0;
        padding: 4px; /* 1/5th of previous (19px / 5 = ~4px) */
        background-color: #ffffff; /* Crisp white */
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
    }
    .window-wrapper {
        flex: 1;
        width: 100%;
        height: 100%;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid #d1d5db;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        display: flex;
        background: #ffffff;
    }
    .canvas-frame {
        width: 100%;
        height: 100%;
        border: none;
        flex: 1;
        display: block;
    }
    .dev-banner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        font-family: system-ui, -apple-system, sans-serif;
        color: #e2e8f0;
        gap: 12px;
    }
</style>
