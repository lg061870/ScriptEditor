<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ScriptEditor.styles.css"]" />

    <!-- ConversaCore.UI styles -->
    <link rel="stylesheet" href="_content/ConversaCore.UI/css/chat-enhanced.css" />
    <link rel="stylesheet" href="_content/ConversaCore.UI/css/chat-styles.css" />
    <link rel="stylesheet" href="_content/ConversaCore.UI/css/adaptive-cards.css" />
    <link rel="stylesheet" href="_content/ConversaCore.UI/css/adaptive-cards-required.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
        window.FontAwesomeConfig = { autoReplaceSvg: 'nest' };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>

    <!-- Custom Adaptive Cards and Chat Interop from ConversaCore.UI -->
    <script src="_content/ConversaCore.UI/js/custom-adaptive-card-renderer.js"></script>
    <script src="_content/ConversaCore.UI/js/adaptive-cards-consolidated.js"></script>
    <script src="_content/ConversaCore.UI/js/chat-interop.js"></script>

    <!-- ScriptEditor Chat Preview Bridge -->
    <script>
        window.postToParent = function (data) {
            try {
                window.parent.postMessage(data, '*');
            } catch (e) { }
        };
        window.initChatPreviewBridge = function (dotNetHelper) {
            window.__chatPreviewReceiver = function (event) {
                if (event.data && typeof event.data === 'object') {
                    if (event.data.type === 'conversa-run-topic' || event.data.type === 'conversa-trigger-reset') {
                        dotNetHelper.invokeMethodAsync('TriggerReset');
                    }
                }
            };
            window.removeEventListener('message', window.__chatPreviewReceiver);
            window.addEventListener('message', window.__chatPreviewReceiver);
        };
    </script>
</body>

</html>
